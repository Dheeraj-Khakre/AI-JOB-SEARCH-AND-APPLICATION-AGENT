# ==============================================================================
# UNIVERSAL LOCAL-FIRST AI JOB SEARCH AND APPLICATION AGENT
# Configuration Environment Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development                # development, testing, production
DEBUG=true
APP_NAME="Universal AI Job Agent"
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://localhost:5173

# Security & Encryption (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_64_character_random_hex_string_for_local_jwt_sessions
ENCRYPTION_MASTER_KEY=replace_with_a_32_byte_base64_encoded_fernet_key_here
SESSION_EXPIRE_MINUTES=1440
ALLOWED_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (SQLite default for local, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/db/app.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_agent_db
DB_ECHO=false

# AI Model Provider (Default: Local Ollama)
# Options: ollama, openai, gemini, anthropic
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.2
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT_SECONDS=120

# Optional Cloud Providers (Disabled by default, requires explicit HITL consent)
ALLOW_CLOUD_FALLBACK=false
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ChromaDB Local Vector Store
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_RESUMES=candidate_resume_chunks
CHROMA_COLLECTION_JDS=job_description_chunks

# Browser Automation & Playwright
PLAYWRIGHT_HEADLESS=false              # Set false so candidate can observe automation
BROWSER_PROFILE_DIR=./data/browser_profiles
PLAYWRIGHT_TIMEOUT_MS=30000
BROWSER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"

# Human-In-The-Loop (HITL) Gatekeeper
REQUIRE_SUBMISSION_APPROVAL=true       # Mandatory: Never submit applications autonomously
APPROVAL_TOKEN_EXPIRY_SECONDS=600

# File Storage Locations
DATA_DIR=./data
RESUME_STORAGE_DIR=./data/resumes
VAULT_STORAGE_DIR=./data/vault
